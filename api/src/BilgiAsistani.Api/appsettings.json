{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Assistant": {
    "DocumentsPath": "data/documents",
    "AnswerMode": "auto",
    "TopK": 5,
    "MinScore": 3.0,
    "MinCoverage": 0.6
  },
  "LlmService": {
    "BaseUrl": "http://localhost:8100",
    "TimeoutSeconds": 120
  },
  "AnswerCacheMinutes": 10
}
