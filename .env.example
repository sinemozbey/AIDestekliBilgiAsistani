# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env dosyası .gitignore'dadır; gerçek anahtarları asla depoya eklemeyin.

# --- LLM servisi (FastAPI / llm-service) ---
# Claude API anahtarı. Boş bırakılırsa LLM servisi "llm_available=false" bildirir ve
# .NET API (auto modunda) LLM'siz çıkarımsal modda yanıt verir.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=low

# --- .NET API (api/) ---
# Yerel "dotnet run" ortam değişkenlerini okur; .env dosyasını yalnızca docker compose okur.
# auto: LLM servisi hazırsa llm, değilse extractive | llm | extractive
Assistant__AnswerMode=auto
# LLM'e gönderilecek en fazla doküman bölümü sayısı
Assistant__TopK=5
# En iyi BM25 skoru bunun altındaysa LLM çağrılmadan "bilgi yok" denir
Assistant__MinScore=3.0
# Çıkarımsal modda soru terimlerinin en iyi bölümde bulunması gereken en düşük oran
Assistant__MinCoverage=0.6
# LLM'e tüm bölümleriyle gönderilecek en fazla doküman sayısı (0: yalnızca en iyi TopK bölüm)
Assistant__ExpandedDocuments=2
LlmService__BaseUrl=http://localhost:8100
LlmService__TimeoutSeconds=120
AnswerCacheMinutes=10
